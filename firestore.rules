rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // Books collection
    match /books/{bookId} {
      
      // Check if user is authenticated
      function isAuthenticated() {
        return request.auth != null;
      }
      
      // Check if user owns the book document
      function isOwner(userId) {
        return isAuthenticated() && request.auth.uid == userId;
      }
      
      // Validate title: required, non-empty after trim, max 100 chars
      function isValidTitle(title) {
        return title is string 
          && title.trim().size() > 0 
          && title.size() <= 100;
      }
      
      // Validate author: required, non-empty after trim, max 60 chars
      function isValidAuthor(author) {
        return author is string 
          && author.trim().size() > 0 
          && author.size() <= 60;
      }
      
      // Validate genre: one of Fiction, Non-Fiction, Academic, Other
      function isValidGenre(genre) {
        return genre in ['Fiction', 'Non-Fiction', 'Academic', 'Other'];
      }
      
      // Validate status: one of To Read, Reading, Finished
      function isValidStatus(status) {
        return status in ['To Read', 'Reading', 'Finished'];
      }
      
      // Validate rating: optional whole number from 0 to 5
      function isValidRating(data) {
        return !('rating' in data) 
          || data.rating == null 
          || (data.rating is int && data.rating >= 0 && data.rating <= 5);
      }
      
      // Validate notes: optional string max 300 chars
      function isValidNotes(data) {
        return !('notes' in data) 
          || data.notes == null 
          || (data.notes is string && data.notes.size() <= 300);
      }
      
      // Validate favorite: optional boolean
      function isValidFavorite(data) {
        return !('favorite' in data) 
          || data.favorite == null 
          || data.favorite is bool;
      }
      
      // Full validation for book document
      function isValidBook(data) {
        return isValidTitle(data.title)
          && isValidAuthor(data.author)
          && isValidGenre(data.genre)
          && isValidStatus(data.status)
          && isValidRating(data)
          && isValidNotes(data)
          && isValidFavorite(data);
      }
      
      // Read: only logged-in user can read their own books
      allow read: if isOwner(resource.data.userId);
      
      // Create: only logged-in user can create a book for themselves with valid data
      allow create: if isOwner(request.resource.data.userId)
        && isValidBook(request.resource.data)
        && !exists(/databases/$(database)/documents/books/$(bookId));
        
      // Update: only owner can update their own book with valid data; userId and createdAt cannot be changed
      allow update: if isOwner(resource.data.userId)
        && request.resource.data.userId == request.auth.uid
        && isValidBook(request.resource.data)
        && (!('createdAt' in resource.data) || !('createdAt' in request.resource.data) || request.resource.data.createdAt == resource.data.createdAt);
        
      // Delete: only owner can delete their own book
      allow delete: if isOwner(resource.data.userId);
    }
  }
}
